/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-ai-tour-guide",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-28",
	"migrations": [
		{
			"new_sqlite_classes": [
				"ChatDurableObject"
			],
			"tag": "v1"
		}
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ChatDurableObject",
				"name": "CHAT_DO"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "ai-tour-guide.darguima.com",
			"custom_domain": true
		}
	],
	"ai": {
		"binding": "AI"
	}
}